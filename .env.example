# Local salt for pseudonymous contributor ids. Change it on your machine.
# Do not commit a private salt that has already been used to share a database.
PEDALATLAS_PSEUDONYM_SALT=change-me-locally

# SQLite paths. The private database holds WhatsApp-derived records and is gitignored.
PEDALATLAS_DB=data/atlas.sqlite
PEDALATLAS_PRIVATE_DB=data/private/community.sqlite

# Jev. Leave the key empty to use the local mock adapter.
# Live calls go to the hosted decide endpoint and never include private WhatsApp text.
JEV_API_KEY=
JEV_API_URL=https://jevtypesafeai.com/api/v1/decide
JEV_MODEL=jev-1.13.0
PEDALATLAS_JEV_MODE=mock

# Optional live lookups. Defaults stay offline so the demo is deterministic.
PEDALATLAS_LIVE_GEO=0
PEDALATLAS_LIVE_WEATHER=0
PEDALATLAS_LIVE_OFFICIAL=0

# Sponsor configuration. Empty means "not connected".
BASE44_APP_ID=
ANBARIC_SERVICES_URL=
ANBARIC_SERVICES_API_KEY=

# Local review of anonymized private drafts. Off by default.
PEDALATLAS_LOCAL_REVIEW=0
